# Copy to .env and fill in. Everything works without an LLM (JC_LLM_PROVIDER=none):
# the engine's own picks and template messages are used instead.

# none | groq | ollama   (see src/journey_compass/config.py, LLM_PROVIDERS)
JC_LLM_PROVIDER=none
# Optional: override the provider's default model
JC_LLM_MODEL=
# Free key from https://console.groq.com (only needed for JC_LLM_PROVIDER=groq)
GROQ_API_KEY=

