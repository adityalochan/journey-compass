# Supabase configuration (Vercel: Project → Settings → Environment Variables)
# Your project's URL; leave unset to use the hackathon project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable / anon key (safe in the browser). NEVER the service_role key.
VITE_SUPABASE_ANON_KEY=your_anon_key_here
